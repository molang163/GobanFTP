# Local build products and generated distribution metadata. These are not
# display entry points unless regenerated for the current release.
^\.git(?:/|$)
^_Inline/
^blib/
^Makefile$
^Makefile\.old$
^META\.(?:json|yml)$
^MYMETA\.(?:json|yml)$
^pm_to_blib$
^GobanFTP-[0-9][^/]*\.tar\.gz$
^GobanFTP-[0-9][^/]*/

# Temporary publish/build scratch files.
^(?!t/fixtures/).*[.]part$
^(?!t/fixtures/).*[.]tmp$
^(?!t/fixtures/).*[.]bak$
^(?!t/fixtures/)(?:.*/)?[.]gobanftp-tmp-[^/]+$

# Local resume memory; not part of release artifacts.
^docs/SESSION_RESTORE\.md$

# Local integration evidence and agent planning notes; not public release files.
^evidence/
^docs/V1_1_GATE_MEMO\.md$
^docs/v1\.1-unattended-plan\.md$
